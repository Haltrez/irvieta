# Copy to .env.local and fill in. Never commit .env.local — it is gitignored.
# Supabase Dashboard → Project Settings → API

# Project URL, e.g. https://abcdefghijkl.supabase.co
SUPABASE_URL=

# SERVICE ROLE key — server-only, bypasses RLS. Keep it secret.
# On Vercel: Project Settings → Environment Variables (do NOT prefix NEXT_PUBLIC_).
SUPABASE_SERVICE_ROLE_KEY=

# Optional. Not used by the signup path today (writes go through the service
# role), but handy if you later add client-side reads of public tables.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional — absolute site URL, used for OpenGraph/canonical metadata.
NEXT_PUBLIC_SITE_URL=https://irvieta.lv
